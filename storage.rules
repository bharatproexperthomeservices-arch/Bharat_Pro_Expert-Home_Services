rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isImageOrPdf() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType == 'application/pdf';
    }

    function isUnderLimit() {
      return request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }

    // Public read access for static images / banners / avatars
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageOrPdf() && isUnderLimit();
    }

    // User profile uploads
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId && isImageOrPdf() && isUnderLimit();
    }

    // Partner KYC document uploads
    match /partners/{partnerId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == partnerId && isImageOrPdf() && isUnderLimit();
    }

    // Support ticket attachment uploads
    match /support/{userId}/{allPaths=**} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId && isImageOrPdf() && isUnderLimit();
    }
  }
}
