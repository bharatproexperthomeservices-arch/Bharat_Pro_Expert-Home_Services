{
  "name": "bharat-pro-expert-home-services",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/ui",
    "packages/db",
    "packages/types"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "vite preview --host 0.0.0.0",
    "dev:api": "node server.js",
    "dev:monorepo": "turbo dev",
    "build:monorepo": "turbo build",
    "lint": "tsc --noEmit",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run prisma:generate --workspace @bpe/db",
    "db:validate": "npm run prisma:validate --workspace @bpe/db",
    "db:migrate": "npm run prisma:migrate:dev --workspace @bpe/db",
    "db:seed": "npm run prisma:seed --workspace @bpe/db",
    "db:studio": "npm run prisma:studio --workspace @bpe/db"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "canvas-confetti": "^1.9.3",
    "firebase": "^11.6.0",
    "lucide-react": "^0.468.0",
    "razorpay": "^2.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "framer-motion": "^12.6.2",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.3",
    "vite": "^6.2.2",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0"
  }
}
