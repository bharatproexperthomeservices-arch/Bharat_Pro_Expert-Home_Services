rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == 'bharatproexperthomeservices@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isApprovedPartner() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/partners/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/partners/$(request.auth.uid)).data.status == 'approved'
      );
    }

    // Admins have full access to all collections
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Public read collections (services, categories, banners, cities, reviews)
    match /services/{serviceId} {
      allow read: if true;
    }
    match /categories/{categoryId} {
      allow read: if true;
    }
    match /banners/{bannerId} {
      allow read: if true;
    }
    match /cities/{cityId} {
      allow read: if true;
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
    }

    // Users / Customers collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isApprovedPartner();
      allow create: if isAuthenticated() && request.auth.uid == userId &&
                     request.resource.data.role == 'customer' &&
                     (!('blocked' in request.resource.data) || request.resource.data.blocked == false);
      allow update: if isOwner(userId) &&
                     !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'blocked', 'status']);
    }

    // Partners collection
    match /partners/{partnerId} {
      allow read: if isAuthenticated();
      allow update: if isOwner(partnerId) &&
                     !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'kycVerified', 'approvedAt', 'approvedBy']);
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.assignedPartnerId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        // Customer can only cancel own booking if work hasn't started
        (isOwner(resource.data.customerId) &&
         request.resource.data.status == 'cancelled' &&
         !(resource.data.status in ['started', 'completed', 'paid'])) ||
        // Assigned partner can update status to allowed progression states
        (isApprovedPartner() &&
         resource.data.assignedPartnerId == request.auth.uid &&
         request.resource.data.status in ['accepted', 'on_the_way', 'started', 'completed'])
      );
    }

    // Jobs and Deliveries
    match /jobs/{jobId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.partnerId == request.auth.uid
      );
      allow update: if isApprovedPartner() && resource.data.partnerId == request.auth.uid;
    }

    match /deliveries/{deliveryId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.partnerId == request.auth.uid
      );
      allow update: if isApprovedPartner() && resource.data.partnerId == request.auth.uid;
    }

    // Payments, Coupons, Support Tickets, Notifications
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && resource.data.customerId == request.auth.uid;
    }
    match /coupons/{couponId} {
      allow read: if isAuthenticated();
    }
    match /supportTickets/{ticketId} {
      allow read, create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    match /otp_verifications/{otpId} {
      allow read, write: if isAuthenticated();
    }
  }
}
