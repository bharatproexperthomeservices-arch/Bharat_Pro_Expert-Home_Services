# Cashfree Payment Gateway credentials: keep these server-only.
# Never prefix CASHFREE_SECRET_KEY with VITE_.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Use sandbox for testing; switch to production only with live Cashfree credentials.
CASHFREE_ENV=sandbox

# Public website URL used by Cashfree return_url (no trailing slash).
PUBLIC_APP_URL=https://bharatproexpert.com

# Optional local API settings
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
