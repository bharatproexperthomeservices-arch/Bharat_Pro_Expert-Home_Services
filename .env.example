# Vite browser variable: public Razorpay Key ID only.
# Set the real value in your local ignored .env file or Vercel Environment Variables.
VITE_RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_PUBLIC_KEY_ID

# Server-only values. Never prefix the secret with VITE_.
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_THE_SAME_MODE_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_SERVER_SECRET

# Optional local API settings
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
