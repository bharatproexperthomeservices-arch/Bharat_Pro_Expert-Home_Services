# Vite browser variables (public keys)
VITE_RAZORPAY_KEY_ID=
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_GOOGLE_MAPS_API_KEY_BROWSER=your-google-maps-browser-key

# Server-only secrets (Never expose to frontend or prefix with VITE_)
GOOGLE_MAPS_API_KEY_SERVER=your-google-maps-server-key
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional local API settings
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
