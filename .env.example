# Browser-safe public key ID. VITE_ values are bundled into the website.
VITE_RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_TEST_KEY_ID

# Server-only secrets: add these in Vercel Project Settings > Environment Variables.
# Never prefix the secret with VITE_ and never commit real credentials.
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_TEST_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_TEST_KEY_SECRET

# Optional local API setting
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
