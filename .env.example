# Vite browser variable: public Razorpay Key ID only.
# Add the real value locally in ignored .env or in Vercel Environment Variables.
VITE_RAZORPAY_KEY_ID=

# Server-only values. Never prefix the secret with VITE_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional local API settings
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
