# Frontend: public Razorpay Key ID only (Vite embeds VITE_* values in browser code)
VITE_RAZORPAY_KEY_ID=rzp_test_replace_with_your_public_key_id

# Server-only Vercel environment variables (never prefix the secret with VITE_)
RAZORPAY_KEY_ID=rzp_test_replace_with_your_public_key_id
RAZORPAY_KEY_SECRET=replace_with_your_server_secret
